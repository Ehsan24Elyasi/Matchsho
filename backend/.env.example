ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
DB_TYPE=sqlite
AUTO_CREATE_DB=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# Required in production for email verification and password recovery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_STARTTLS=true
# SMTP_SSL=false

# Production PostgreSQL
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=matchsho
# DB_USER=matchsho
# DB_PASSWORD=replace-me
# DB_SSLMODE=require
# AUTO_CREATE_DB=false
# COOKIE_SECURE=true
# CORS_ORIGINS=https://matchshoapp.ir
# REQUIRE_EMAIL_VERIFICATION=true
# PUBLIC_BASE_URL=https://matchshoapp.ir
# ALLOWED_HOSTS=matchshoapp.ir,127.0.0.1

# Optional initial administrator; never commit real values.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-me-with-a-long-random-password
